{
  "name": "projectlearn",
  "private": true,
  "version": "0.1.0",
  "description": "Learn any topic the 80/20 way: core lessons, worked examples, exercises, quizzes and spaced repetition.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,green \"vite\" \"node --watch --env-file-if-exists=.env server/index.ts\"",
    "build": "tsc && tsc -p tsconfig.server.json && node scripts/check-content.ts && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts --prod",
    "check:content": "node scripts/check-content.ts",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "test": "node --test tests/*.test.ts",
    "db:local": "sh scripts/local-db.sh",
    "db:stop": "pg_ctl -D data/pg stop"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vercel": "^62.7.0",
    "vite": "^8.3.2"
  }
}
