# Copy this file to .env and fill in what you need. Everything is optional for local development.

# Port of the API server in development (the website runs on 5173 and forwards /api here).
# API_PORT=3001
# In production (`npm start`) the server serves the site and API together on PORT (default 3001).
# PORT=3001

# Public address of the site — used in links inside emails.
# Development default: http://localhost:5173   Production default: http://localhost:3001
# APP_URL=https://learn.example.com

# Real email delivery. Without SMTP_HOST, emails show up in the dev mailbox (http://localhost:5173/#/dev/mailbox).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
# SMTP_PASS=<an App Password from https://myaccount.google.com/apppasswords — not your normal password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ProjectLearn <no-reply@example.com>

# Where the SQLite database is stored (default: ./data).
# DATA_DIR=./data
